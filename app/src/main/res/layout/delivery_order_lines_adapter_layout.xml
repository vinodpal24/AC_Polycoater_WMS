            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_5"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="Batch Code"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_40"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/round_gray_backgruand"
                    android:fontFamily="@font/muli_bold"
                    android:gravity="center_vertical"
                    android:hint="Scan Item"
                    android:orientation="horizontal"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:boxStrokeColor="@color/colorPrimary">

                    <EditText
                        android:id="@+id/ed_batch_code_scan"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.85"
                        android:background="@null"
                        android:ellipsize="end"
                        android:focusableInTouchMode="true"
                        android:fontFamily="@font/muli_bold"
                        android:hint="Scan item"
                        android:imeOptions="actionDone|actionGo|actionSend"
                        android:lines="1"
                        android:maxLines="1"
                        android:paddingLeft="8sp"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textSize="12sp" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivScanBatchCode"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end|center_vertical"
                        android:layout_weight="0.15"
                        android:paddingVertical="@dimen/size_7"
                        android:src="@drawable/ic_baseline_qr_code_scanner_24" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_40"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/round_gray_backgruand"
                    android:fontFamily="@font/muli_bold"
                    android:gravity="center_vertical"
                    android:hint="Enter mannual Batch"
                    android:orientation="horizontal"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:boxStrokeColor="@color/colorPrimary">

                    <EditText
                        android:id="@+id/etMannualBatch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.55"
                        android:background="@null"
                        android:enabled="false"
                        android:ellipsize="end"
                        android:focusableInTouchMode="true"
                        android:fontFamily="@font/muli_bold"
                        android:hint="Enter mannual Batch"
                        android:imeOptions="actionDone|actionGo|actionSend"
                        android:lines="1"
                        android:maxLines="1"
                        android:paddingLeft="8sp"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnMannualBatch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/size_10"
                        android:layout_weight="0.30"
                        android:enabled="false"
                        android:text="Submit" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchMannualBatch"
                        android:layout_width="0dp"
                        android:checked="false"
                        android:layout_height="match_parent"
                        android:layout_gravity="end|center_vertical"
                        android:layout_weight="0.18"
                        android:paddingVertical="@dimen/size_7"
                        android:src="@drawable/ic_baseline_qr_code_scanner_24" />

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
